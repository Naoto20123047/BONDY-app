# アプリの環境変数のひな形。
# 値を入れて **.env** という名前で保存する(.env はコミットされない)。
# 引き継ぎのときは、このファイルではなく実際の値を別途受け渡すこと。
#
# Firebase の値は Firebase コンソール → プロジェクトの設定 → マイアプリ で確認できる。
# これらはビルド結果に埋め込まれて誰でも見られる状態になるため、**秘密ではない。**
# アクセス制御は firestore.rules が担っている。
# (それでも .env を追跡しないのは、プロジェクトの取り違えや設定ミスを防ぐため)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Cloudflare Worker の URL。wrangler deploy で払い出される。
# 未設定でもアプリは動くが、紹介ページの画像・Teams通知・
# 除籍時のアカウント無効化が**黙って無効になる**ので注意。
VITE_WORKER_URL=
